# =====================================================
# wiki-rag .gitignore
# Python + Node + macOS + project-specific
# =====================================================

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# ----- Windows -----
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Editors / IDEs -----
.vscode/
.idea/
*.swp
*.swo
*.swn
*~

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtualenvs
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints

# ----- Node / Frontend -----
node_modules/
.pnp
.pnp.js
.yarn-integrity
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
web-frontend/dist/
web-frontend/build/
web-frontend/.vite/
*.local

# TypeScript build info
*.tsbuildinfo

# ----- Logs -----
logs
*.log

# ----- Env files -----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =====================================================
# wiki-rag project-specific
# =====================================================

# Embedding cache (regenerated automatically)
cache/

# Build artifacts of the RAG pipeline
data/index.json

# Personal notes — keep example files only
data/raw/*
!data/raw/.gitkeep
!data/raw/example.md

data/wiki/*
!data/wiki/.gitkeep
!data/wiki/example.md
